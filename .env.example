# CloudPilot environment template. Copy to apps/api/.env (development) or
# /etc/cloudpilot/cloudpilot.env (production) and fill in. Never commit real values.

NODE_ENV=development                 # development | staging | production
DATABASE_URL=postgresql://cloudpilot:CHANGE_ME@127.0.0.1:5432/cloudpilot
REDIS_URL=redis://127.0.0.1:6379/0

# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts hypervisor credentials, webhook secrets and provisioning passwords at rest.
APP_ENCRYPTION_KEY=
# At least 32 chars:        openssl rand -base64 48
JWT_SECRET=

API_PORT=4000
PUBLIC_API_URL=https://api.example.com     # used in sandbox checkout links
WEB_ORIGIN=https://panel.example.com       # comma-separated allowed browser origins

# Payment gateways (leave blank to disable)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Built-in sandbox gateway for dev/staging ONLY. Refused at startup when NODE_ENV=production.
SANDBOX_GATEWAY_SECRET=

# Development only: allow webhook delivery to private/loopback addresses. Refused in production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

IP_RESERVATION_MINUTES=30
PROVISIONING_MAX_ATTEMPTS=3
LOG_LEVEL=info

# Seed (npm run db:seed) — first platform administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=Crapplet Infotech Private Limited
SEED_BRAND=CloudPilot

# Web (apps/web) — where the Next.js server reaches the API
CLOUDPILOT_API_URL=http://127.0.0.1:4000
